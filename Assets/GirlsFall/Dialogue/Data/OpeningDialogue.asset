  m_Script: {fileID: 11500000, guid: e204c0aaff8a0b549b8eff35fed428bc, type: 3}
  m_Name: OpeningDialogue
  m_EditorClassIdentifier: Assembly-CSharp::GirlsFall.Dialogue.DialogueData
  defaultCharacterName: "\u4E3B\u4EBA\u516C"
  defaultCharactersPerSecond: 32
  lines:
  - characterName: 
    text: "\u2026\u2026\u3053\u3053\u306F\u3001\u3069\u3053\uFF1F\n\u7A7A\u306B\u3001\u304A\u83D3\u5B50\u306E\u5CF6\u304C\u6D6E\u304B\u3093\u3067\u308B\u2026\u2026\uFF01"
    expression: 1
    charactersPerSecond: 0
    delayBefore: 0.2
  - characterName: 
    text: "\u30AF\u30C3\u30AD\u30FC\u306E\u9053\u306B\u3001\u30AF\u30EA\u30FC\u30E0\u306E\u304A\u57CE\u3002\n\u306A\u3093\u3060\u304B\u5922\u306E\u4E2D\u307F\u305F\u3044\u3002"
    expression: 0
    charactersPerSecond: 0
    delayBefore: 0
  - characterName: 
    text: "\u3067\u3082\u3001\u3042\u3093\u306A\u306B\u9AD8\u3044\u3068\u3053\u308D\u307E\u3067\u767B\u308B\u306E\uFF1F\n\u8DB3\u3092\u8E0F\u307F\u5916\u3057\u305F\u3089\u2026\u2026\u3061\u3087\u3063\u3068\u6016\u3044\u306A\u3002"
    expression: 4
    charactersPerSecond: 0
    delayBefore: 0
  - characterName: 
    text: "\u843D\u3061\u3061\u3083\u3063\u305F\u3089\u3001\u6CE3\u3044\u3061\u3083\u3046\u304B\u3082\u2026\u2026\u3002\n\u3067\u3082\u3001\u4E0B\u304B\u3089\u3082\u3046\u4E00\u5EA6\u6311\u6226\u3059\u308C\u3070\u3044\u3044\u3088\u306D\u3002"
    expression: 2
    charactersPerSecond: 0
    delayBefore: 0
  - characterName: 
    text: "\u3088\u3057\u3001\u6016\u304C\u3063\u3066\u3070\u304B\u308A\u3058\u3083\u9032\u3081\u306A\u3044\uFF01\n\u3042\u306E\u304A\u57CE\u3092\u76EE\u6307\u3057\u3066\u3001\u884C\u3063\u3066\u307F\u3088\u3046\uFF01"
    expression: 3
    charactersPerSecond: 0
    delayBefore: 0
